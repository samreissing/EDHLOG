# Copy to .env.local for local dev with cloud sync enabled.
# GitHub Actions: add these as repository secrets for deploy.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: reject any signed-in user whose email does not match (client-side guard).
VITE_ALLOWED_EMAIL=you@example.com
